# ───────────────────────── AgentShield ─────────────────────────
# Copy to .env. Everything below works with zero AWS setup.
#   Windows:  Copy-Item .env.example .env
#   POSIX:    cp .env.example .env

# ── Core ──────────────────────────────────────────────────────
AGENTSHIELD_ENV=local                 # local | aws   ← the ONLY switch
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# ── Local adapters ────────────────────────────────────────────
SQLITE_PATH=./.data/agentshield.db
BLOB_DIR=./.data/blobs
LOCAL_OUTBOX_TABLE=outbox

# ── LLM ───────────────────────────────────────────────────────
LLM_PROVIDER=hybrid                   # mock | ollama | bedrock | hybrid
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_STANDARD=qwen2.5-coder:7b
OLLAMA_MODEL_TRIVIAL=qwen2.5-coder:1.5b
LLM_TIMEOUT_SECONDS=45
LLM_MAX_ITERATIONS=8                  # agent tool-use loop cap

# -- Free cloud LLM (hybrid provider; OpenAI-compatible) ------
# One API key covers Groq (default), Gemini's OpenAI-compat endpoint,
# or OpenRouter. Free tier: console.groq.com -- no card needed.
# Leave LLM_CLOUD_API_KEY empty to run fully offline (Ollama -> Mock).
LLM_CLOUD_BASE_URL=https://api.groq.com/openai/v1
LLM_CLOUD_API_KEY=
LLM_CLOUD_MODEL_TRIVIAL=openai/gpt-oss-20b
LLM_CLOUD_MODEL_STANDARD=openai/gpt-oss-20b
LLM_CLOUD_MODEL_COMPLEX=openai/gpt-oss-120b
LLM_CLOUD_RPM=28                      # requests/min cap (Groq free tier ~30)
LLM_CLOUD_MAX_RETRIES=4
LLM_CLOUD_BREAKER_THRESHOLD=6         # consecutive failures before skipping the cloud tier
LLM_CLOUD_BREAKER_COOLDOWN_S=60      # how long the breaker stays open

# ── Nebius Token Factory (NVIDIA Nemotron) — Autopilot's live model ──
# Get a key at console.nebius.com (AI Studio / Token Factory).
# Set LLM_PROVIDER=nebius to route Autopilot through it. NO mock fallback
# exists on this provider: without a key, Autopilot jobs fail honestly
# rather than running scripted output.
NEBIUS_BASE_URL=https://api.studio.nebius.com/v1
NEBIUS_API_KEY=
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
NEBIUS_TIMEOUT_SECONDS=120
NEBIUS_MAX_RETRIES=2
NEBIUS_RPM=60

# ── Simulation ────────────────────────────────────────────────
SIM_SEED=20260918
SIM_EMPLOYEE_COUNT=20
SIM_MAX_CONCURRENT_SESSIONS=2         # keep under free-tier rate limits
SIM_TICK_SIM_SECONDS=60               # one tick = one simulated minute
SIM_DEFAULT_SPEED=1                   # 0 | 1 | 10 | 100
SIM_LLM_INVOCATION_RATE=0.40          # fraction of sessions using a real model (0.08 = marquee only)
SIM_SCENARIO_FILE=./scenarios/demo.yaml

# ── Governance ────────────────────────────────────────────────
APPROVAL_TTL_SIM_SECONDS=300
RETRY_LOOP_THRESHOLD=3                # identical args_digest within 5 sim-minutes
REDACTION_ENABLED=true

# ── Risk ──────────────────────────────────────────────────────
RISK_WEIGHT_STATIC=0.35
RISK_WEIGHT_BEHAVIOURAL=0.40
RISK_WEIGHT_ML=0.25
RISK_BASELINE_WINDOW_DAYS=14
RISK_MIN_SESSIONS_FOR_BASELINE=20
RISK_INCIDENT_THRESHOLD=70
ISOLATION_FOREST_ESTIMATORS=200
ISOLATION_FOREST_CONTAMINATION=0.03

# ── Live Mode ingest ──────────────────────────────────────────
INGEST_ENABLED=true
INGEST_TOKENS=dev-token-1:emp_003,dev-token-2:emp_011   # token:actor_id pairs

# ── AWS (ignored entirely when AGENTSHIELD_ENV=local) ─────────
AWS_REGION=ap-south-1
AGENTSHIELD_TABLE=agentshield
AGENTSHIELD_BUCKET=agentshield-artifacts
AGENTSHIELD_BUS=agentshield-bus
CLOUDWATCH_NAMESPACE=AgentShield
BEDROCK_MODEL_TRIVIAL=anthropic.claude-3-5-haiku-20241022-v1:0
BEDROCK_MODEL_STANDARD=anthropic.claude-3-5-haiku-20241022-v1:0
BEDROCK_MODEL_COMPLEX=anthropic.claude-3-5-sonnet-20241022-v2:0
SQS_QUEUE_URL=
# Credentials come from the standard chain (env, profile, or task role).
# Never put AWS keys in this file.
