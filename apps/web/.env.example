# Copy to apps/web/.env. Both defaults are same-origin, resolved by the Vite
# dev-server proxy in development and by the deployed origin in production, so
# nothing under src/ ever hardcodes a host.
VITE_API_BASE=/api/v1
VITE_WS_URL=/ws/stream
VITE_DEFAULT_ROLE=security_admin   # security_admin | manager | ceo | engineer
