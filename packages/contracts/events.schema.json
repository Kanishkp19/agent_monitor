{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentshield.dev/schemas/events.schema.json",
  "title": "AgentShield telemetry events",
  "description": "The single source of truth for event shapes. Pydantic models and TypeScript types are generated from this file by generate.py; neither is hand-written. See docs/DECISIONS-RESOLVED.md C1 and C7.",
  "version": "1.0.0",

  "envelope": {
    "description": "EventBridge-shaped from day one. Moving to EventBridge changes the transport, not the payload.",
    "fields": {
      "id": "string",
      "source": "string",
      "detail_type": "string",
      "time": "string",
      "detail": {
        "run_id": "string",
        "seq": "integer",
        "sim_ts": "integer",
        "employee_id": "string | null",
        "task_id": "string | null",
        "payload": "object"
      }
    }
  },

  "events": {
    "sim.tick": {
      "emitted_by": "sim/engine.py",
      "office": false,
      "properties": {
        "sim_ts": { "type": "integer" },
        "active_sessions": { "type": "integer" },
        "queued_tasks": { "type": "integer" }
      },
      "required": ["sim_ts", "active_sessions", "queued_tasks"]
    },

    "sim.day.completed": {
      "emitted_by": "sim/engine.py",
      "office": false,
      "properties": {
        "sim_day": { "type": "integer" },
        "tasks": { "type": "integer" },
        "events": { "type": "integer" },
        "cost_usd": { "type": "number" },
        "blocked": { "type": "integer" },
        "approvals": { "type": "integer" },
        "incidents": { "type": "integer" }
      },
      "required": ["sim_day", "tasks", "events", "cost_usd", "blocked", "approvals", "incidents"]
    },

    "sim.meeting.started": {
      "emitted_by": "sim/scenarios.py",
      "office": true,
      "description": "Purely cosmetic. Moves avatars to the meeting room; no governed outcome depends on it.",
      "properties": {
        "meeting_id": { "type": "string" },
        "attendees": { "type": "array", "items": { "type": "string" } },
        "room": { "type": "string" }
      },
      "required": ["meeting_id", "attendees"]
    },

    "sim.meeting.ended": {
      "emitted_by": "sim/scenarios.py",
      "office": true,
      "properties": {
        "meeting_id": { "type": "string" },
        "attendees": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["meeting_id", "attendees"]
    },

    "task.requested": {
      "emitted_by": "sim/engine.py, /ingest/gate1",
      "office": true,
      "properties": {
        "task_id": { "type": "string" },
        "employee_id": { "type": "string" },
        "title": { "type": "string" },
        "task_type": { "type": "string" },
        "complexity": { "type": "string" },
        "repo": { "type": "string" },
        "environment": { "type": "string" },
        "is_marquee": { "type": "boolean" }
      },
      "required": ["task_id", "employee_id", "title", "task_type", "complexity", "repo", "environment", "is_marquee"]
    },

    "gate1.decision": {
      "emitted_by": "the gate1 caller",
      "office": true,
      "description": "findings carry the masked form only. A raw secret value never appears in an event payload, a log line, or anything sent to the frontend.",
      "properties": {
        "task_id": { "type": "string" },
        "request_id": { "type": "string" },
        "decision": { "type": "string" },
        "reason_code": { "type": "string" },
        "matched_policies": { "type": "array", "items": { "$ref": "#/shared/PolicyMatch" } },
        "est_input_tokens": { "type": "integer" },
        "est_output_tokens": { "type": "integer" },
        "est_cost_usd": { "type": "number" },
        "routed_model": { "type": "string" },
        "findings": { "type": "array", "items": { "$ref": "#/shared/MaskedFinding" } },
        "budget_remaining_usd": { "type": "number" },
        "latency_ms": { "type": "number" }
      },
      "required": ["task_id", "request_id", "decision", "reason_code", "matched_policies", "routed_model", "latency_ms"]
    },

    "model.invoked": {
      "emitted_by": "agent/runner.py",
      "office": false,
      "properties": {
        "task_id": { "type": "string" },
        "model_id": { "type": "string" },
        "input_tokens": { "type": "integer" },
        "output_tokens": { "type": "integer" },
        "cost_usd": { "type": "number" },
        "iteration": { "type": "integer" },
        "stop_reason": { "type": "string" },
        "fallback": { "type": "boolean" }
      },
      "required": ["task_id", "model_id", "input_tokens", "output_tokens", "cost_usd", "iteration", "stop_reason", "fallback"]
    },

    "action.requested": {
      "emitted_by": "agent/runner.py",
      "office": false,
      "properties": {
        "task_id": { "type": "string" },
        "action_id": { "type": "string" },
        "tool": { "type": "string" },
        "target_resource": { "type": "string" },
        "environment": { "type": "string" },
        "resource_sensitivity": { "type": "string" },
        "args_digest": { "type": "string" },
        "iteration": { "type": "integer" }
      },
      "required": ["task_id", "action_id", "tool", "target_resource", "environment", "resource_sensitivity", "args_digest", "iteration"]
    },

    "gate2.decision": {
      "emitted_by": "the gate2 caller",
      "office": true,
      "properties": {
        "task_id": { "type": "string" },
        "action_id": { "type": "string" },
        "tool": { "type": "string" },
        "decision": { "type": "string" },
        "reason_code": { "type": "string" },
        "matched_policies": { "type": "array", "items": { "$ref": "#/shared/PolicyMatch" } },
        "target_resource": { "type": "string" },
        "environment": { "type": "string" },
        "repeat_count_5m": { "type": "integer" },
        "latency_ms": { "type": "number" }
      },
      "required": ["task_id", "action_id", "tool", "decision", "reason_code", "matched_policies", "target_resource", "environment", "latency_ms"]
    },

    "approval.requested": {
      "emitted_by": "governance/approvals.py",
      "office": true,
      "properties": {
        "approval_id": { "type": "string" },
        "task_id": { "type": "string" },
        "action_id": { "type": "string" },
        "requester_id": { "type": "string" },
        "approver_role": { "type": "string" },
        "approver_scope": { "type": "string" },
        "reason": { "type": "string" },
        "risk_at_request": { "type": "integer" },
        "cost_so_far_usd": { "type": "number" },
        "expires_sim_ts": { "type": "integer" }
      },
      "required": ["approval_id", "task_id", "action_id", "requester_id", "reason", "expires_sim_ts"]
    },

    "approval.decided": {
      "emitted_by": "governance/approvals.py",
      "office": true,
      "properties": {
        "approval_id": { "type": "string" },
        "task_id": { "type": "string" },
        "status": { "type": "string" },
        "approver_id": { "type": "string" },
        "note": { "type": "string" },
        "latency_sim_s": { "type": "integer" }
      },
      "required": ["approval_id", "task_id", "status", "latency_sim_s"]
    },

    "sandbox.executed": {
      "emitted_by": "sandbox/",
      "office": false,
      "properties": {
        "task_id": { "type": "string" },
        "action_id": { "type": "string" },
        "tool": { "type": "string" },
        "ok": { "type": "boolean" },
        "duration_ms": { "type": "integer" },
        "output_preview": { "type": "string", "maxLength": 200 }
      },
      "required": ["task_id", "action_id", "tool", "ok", "duration_ms"]
    },

    "action.blocked": {
      "emitted_by": "agent/runner.py",
      "office": false,
      "properties": {
        "task_id": { "type": "string" },
        "action_id": { "type": "string" },
        "tool": { "type": "string" },
        "target_resource": { "type": "string" },
        "policy_id": { "type": "string" },
        "message": { "type": "string" }
      },
      "required": ["task_id", "action_id", "tool", "target_resource", "message"]
    },

    "task.completed": {
      "emitted_by": "agent/runner.py",
      "office": true,
      "properties": {
        "task_id": { "type": "string" },
        "employee_id": { "type": "string" },
        "status": { "type": "string" },
        "tokens_in": { "type": "integer" },
        "tokens_out": { "type": "integer" },
        "cost_usd": { "type": "number" },
        "actions_total": { "type": "integer" },
        "actions_blocked": { "type": "integer" },
        "duration_sim_s": { "type": "integer" }
      },
      "required": ["task_id", "employee_id", "status", "tokens_in", "tokens_out", "cost_usd", "actions_total", "actions_blocked", "duration_sim_s"]
    },

    "budget.exceeded": {
      "emitted_by": "the budget caller",
      "office": false,
      "properties": {
        "employee_id": { "type": "string" },
        "scope": { "type": "string", "enum": ["employee", "team"] },
        "budget_usd": { "type": "number" },
        "spend_usd": { "type": "number" },
        "sim_date": { "type": "string" }
      },
      "required": ["employee_id", "scope", "budget_usd", "spend_usd", "sim_date"]
    },

    "risk.updated": {
      "emitted_by": "the risk scoring caller",
      "office": true,
      "description": "The office applies an anomaly overlay at score >= 70 and clears it below 60. The overlay is not a state: an employee can be visibly working and flagged at the same time, which is the most interesting thing the demo can show.",
      "properties": {
        "employee_id": { "type": "string" },
        "score": { "type": "integer" },
        "static": { "type": "integer" },
        "behavioural": { "type": "integer" },
        "ml": { "type": "integer" },
        "confidence": { "type": "string" },
        "top_factors": { "type": "array", "items": { "$ref": "#/shared/RiskFactor" } },
        "delta": { "type": "integer" }
      },
      "required": ["employee_id", "score", "static", "behavioural", "ml", "confidence"]
    },

    "incident.opened": {
      "emitted_by": "risk/incidents.py",
      "office": false,
      "properties": {
        "incident_id": { "type": "string" },
        "employee_id": { "type": "string" },
        "detector": { "type": "string" },
        "score": { "type": "integer" },
        "summary": { "type": "string" },
        "evidence_count": { "type": "integer" }
      },
      "required": ["incident_id", "employee_id", "detector", "score", "summary", "evidence_count"]
    },

    "autopilot.state": {
      "emitted_by": "autopilot/runner.py", "office": false,
      "properties": { "state": { "type": "string" } },
      "required": ["state"]
    },
    "autopilot.gate": {
      "emitted_by": "autopilot/runner.py", "office": false,
      "properties": { "gate": { "type": "integer" }, "tool": { "type": "string" },
        "path": { "type": "string" }, "decision": { "type": "string" },
        "reason": { "type": "string" } },
      "required": ["gate", "decision", "reason"]
    },
    "autopilot.model": {
      "emitted_by": "autopilot/runner.py", "office": false,
      "properties": { "provider": { "type": "string" }, "model_id": { "type": "string" },
        "tokens_in": { "type": "integer" }, "tokens_out": { "type": "integer" },
        "latency_ms": { "type": "number" }, "retry_count": { "type": "integer" },
        "is_mock": { "type": "boolean" } },
      "required": ["provider", "model_id", "tokens_in", "tokens_out", "latency_ms", "is_mock"]
    },
    "autopilot.action": {
      "emitted_by": "autopilot/runner.py", "office": false,
      "properties": { "tool": { "type": "string" }, "args": { "type": "string" },
        "decision": { "type": "string" }, "result": { "type": "object" } },
      "required": ["tool", "decision", "result"]
    },
    "autopilot.test": {
      "emitted_by": "autopilot/runner.py", "office": false,
      "properties": { "phase": { "type": "string" }, "passed": { "type": "boolean" },
        "exit_code": { "type": "integer" }, "stdout": { "type": "string" },
        "stderr": { "type": "string" }, "duration_ms": { "type": "number" },
        "timed_out": { "type": "boolean" }, "summary_line": { "type": "string" } },
      "required": ["phase", "passed", "exit_code", "stdout", "stderr", "duration_ms"]
    },
    "audit.raw_access": {
      "emitted_by": "the blob store reader",
      "office": false,
      "description": "The blob store is the only home for raw prompts, and every read of one is audited. Without this the redaction guarantee is unverifiable.",
      "properties": {
        "task_id": { "type": "string" },
        "blob_key": { "type": "string" },
        "actor_id": { "type": "string" },
        "reason": { "type": "string" }
      },
      "required": ["task_id", "blob_key", "actor_id"]
    }
  },

  "shared": {
    "PolicyMatch": {
      "properties": {
        "policy_id": { "type": "string" },
        "version": { "type": "integer" },
        "effect": { "type": "string" },
        "priority": { "type": "integer" }
      },
      "required": ["policy_id", "version", "effect", "priority"]
    },
    "MaskedFinding": {
      "properties": {
        "detector": { "type": "string" },
        "masked": { "type": "string" }
      },
      "required": ["detector", "masked"]
    },
    "RiskFactor": {
      "properties": {
        "feature": { "type": "string" },
        "value": { "type": "number" },
        "z": { "type": "number" },
        "contribution": { "type": "number" },
        "explanation": { "type": "string" }
      },
      "required": ["feature", "value", "z", "explanation"]
    }
  }
}
